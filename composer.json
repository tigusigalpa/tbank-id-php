{
    "name": "tigusigalpa/tbank-id-php",
    "description": "PHP/Laravel package for TBank ID (OAuth2) integration",
    "keywords": ["tbank", "tinkoff", "oauth2", "laravel", "authentication"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Igor Sazonov",
            "email": "sovletig@gmail.com"
        }
    ],
    "require": {
        "php": "^7.4|^8.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0|^10.0",
        "orchestra/testbench": "^6.0|^7.0|^8.0|^9.0"
    },
    "autoload": {
        "psr-4": {
            "Tigusigalpa\\TBankID\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tigusigalpa\\TBankID\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tigusigalpa\\TBankID\\TBankIDServiceProvider"
            ],
            "aliases": {
                "TBankID": "Tigusigalpa\\TBankID\\Facades\\TBankID"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
